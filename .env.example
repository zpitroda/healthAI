# ==============================================================================
# healthAI Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI COPILOT LLM CONFIGURATION
# ------------------------------------------------------------------------------
# OPTION A: Local llama-server on RTX 5090 / Ollama (Default local unsloth/Qwen3.8-27B-GGUF)
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_MODEL=Qwen3.8-27B-UD-Q6_K_M.gguf
# OPENAI_MAX_TOKENS=8192

# OPTION B: Cloud OpenRouter (Direct Qwen 3.8 27B for live cloud deployment)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key
# OPENAI_MODEL=qwen/qwen3.8-27b
# OPENAI_MAX_TOKENS=8192
# REASONING_EFFORT=medium          # "low", "medium", or "high" (controls OpenRouter thinking depth)
# REASONING_MAX_TOKENS=512         # Caps reasoning token count on OpenRouter/Groq (e.g., 256, 512, 1024)

# ------------------------------------------------------------------------------
# 2. DATABASE & GRAPH ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Neo4j Graph Database (Optional: falls back to in-memory multigraph if offline)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# ------------------------------------------------------------------------------
# 3. LITERATURE MINING & PUBMED CONFIGURATION
# ------------------------------------------------------------------------------
# NCBI API Key (get free at https://www.ncbi.nlm.nih.gov/account/settings/)
# Enables 10 requests/sec to PubMed E-Utilities (vs 3/sec without)
# NCBI_API_KEY=your_ncbi_api_key_here

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
