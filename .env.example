# ==============================================================================
# healthAI Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI COPILOT LLM CONFIGURATION
# ------------------------------------------------------------------------------
# OPTION A: Local llama-server on RTX 5090 / Ollama (Default local - leave empty for auto-detect)
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_MODEL=qwen3.8:27b

# OPTION B: Cloud Groq (Ultra-fast Qwen 3.6 / Qwen models, recommended for Hostinger live production)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your_groq_api_key
# OPENAI_MODEL=qwen3.6:27b

# OPTION C: Cloud OpenRouter (Access to Qwen 3.8, Qwen 3.6, Qwen 2.5 72B, Claude 3.5, GPT-4o)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key
# OPENAI_MODEL=qwen/qwen3.6-27b

# OPTION D: Cloud DeepSeek (PhD-level biomedical reasoning at low cost)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-your_deepseek_api_key
# OPENAI_MODEL=deepseek-chat

# OPTION E: OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. DATABASE & GRAPH ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Neo4j Graph Database (Optional: falls back to in-memory multigraph if offline)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# ------------------------------------------------------------------------------
# 3. LITERATURE MINING & PUBMED CONFIGURATION
# ------------------------------------------------------------------------------
# NCBI API Key (get free at https://www.ncbi.nlm.nih.gov/account/settings/)
# Enables 10 requests/sec to PubMed E-Utilities (vs 3/sec without)
# NCBI_API_KEY=your_ncbi_api_key_here

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
