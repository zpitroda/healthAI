*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*.progress
*~
*.pid
*.seed
*.dmp
*.crash

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

